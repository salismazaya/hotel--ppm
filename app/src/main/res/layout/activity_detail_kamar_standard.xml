<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#121212"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail Kamar"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </androidx.appcompat.widget.Toolbar>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarDetail"
        app:layout_constraintBottom_toTopOf="@id/btnPesan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FOTO KAMAR -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:src="@drawable/standard"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- NAMA + RATING -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Standard Room"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#121212"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★★★★☆ (4.5)"
                    android:textColor="#D4AF37"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <!-- HARGA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 450.000 / malam"
                    android:textColor="#D32F2F"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <!-- DESKRIPSI -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deskripsi"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#121212"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Standard Room menawarkan kenyamanan dengan desain modern, cocok untuk perjalanan bisnis maupun liburan. Dilengkapi fasilitas utama untuk pengalaman menginap yang menyenangkan."
                    android:textColor="#555555"
                    android:justificationMode="inter_word"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="12dp"/>

                <!-- GARIS -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="16dp"/>

                <!-- DETAIL KAMAR -->
                <!-- HEADER DETAIL KAMAR -->
                <LinearLayout
                    android:id="@+id/headerDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="0dp"
                    android:clickable="true"
                    android:focusable="true">



                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Detail Kamar"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#121212"
                        />

                    <ImageView
                        android:id="@+id/iconDetailArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_down"/>
                </LinearLayout>

                <!-- ISI DETAIL (HIDDEN) -->
                <LinearLayout
                    android:id="@+id/contentDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Luas: 24 m²\n• Kapasitas: 2 Dewasa\n• Kasur: Queen Bed\n• Pemandangan: Kota"
                        android:textSize="14sp"
                        android:textColor="#555555"/>
                </LinearLayout>


                <!-- GARIS -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="16dp"/>

                <!-- FASILITAS -->
                <LinearLayout
                    android:id="@+id/headerFasilitas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="0dp"
                    android:clickable="true"
                    android:focusable="true">



                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fasilitas"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        />

                    <ImageView
                        android:id="@+id/iconFasilitasArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_down"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentFasilitas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• WiFi Gratis\n• AC\n• TV LED\n• Air Panas\n• Room Service"
                        android:textSize="14sp"/>
                </LinearLayout>




                <!-- INFO TAMBAHAN -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginVertical="16dp"/>


                <LinearLayout
                    android:id="@+id/headerInformasiTambahan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Informasi Tambahan"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#121212"/>

                    <ImageView
                        android:id="@+id/iconInformasiArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_down"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentInformasiTambahan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Check-in mulai pukul 14.00\n• Check-out maksimal pukul 12.00\n• Dilarang merokok di dalam kamar\n• Hewan peliharaan tidak diperbolehkan\n• Tersedia layanan laundry berbayar"
                        android:textSize="14sp"
                        android:textColor="#555555"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>



            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BUTTON PESAN -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPesan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Pilih Tanggal Menginap"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#D4AF37"
        android:layout_margin="16dp"
        app:cornerRadius="16dp"
        app:backgroundTint="#121212"
        app:elevation="6dp"
        app:rippleColor="#FFF3C0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
